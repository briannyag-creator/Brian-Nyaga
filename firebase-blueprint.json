{
  "entities": {
    "UserPrivateProfile": {
      "title": "UserPrivateProfile",
      "description": "Private customer or technician PII isolated under users/{userId}/private/profile",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "maxLength": 120
        },
        "mpesaPhone": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^(|(\\+254|0)[17]\\d{8})$"
        },
        "county": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "town": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "enum": ["customer", "technician"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "mpesaPhone", "county", "town", "role", "createdAt", "updatedAt"]
    },
    "Technician": {
      "title": "Technician",
      "description": "Public Kenyan technician service profile with geolocation coordinates and zero PII",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "trade": {
          "type": "string",
          "enum": [
            "Electrical & Solar",
            "Plumbing & Borehole",
            "Refrigeration & AC",
            "Automotive Diagnostics",
            "ICT & Fiber",
            "Appliance Repair",
            "Welding & Masonry"
          ]
        },
        "county": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "town": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "serviceRadiusKm": {
          "type": "number"
        },
        "calloutFeeKes": {
          "type": "number"
        },
        "hourlyRateKes": {
          "type": "number"
        },
        "experienceYears": {
          "type": "number"
        },
        "certification": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "bio": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500
        },
        "availableNow": {
          "type": "boolean"
        },
        "remoteSupport": {
          "type": "boolean"
        },
        "languages": {
          "type": "array"
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 300
        },
        "ratingAvg": {
          "type": "number"
        },
        "jobsCompleted": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "fullName",
        "trade",
        "county",
        "town",
        "lat",
        "lng",
        "serviceRadiusKm",
        "calloutFeeKes",
        "hourlyRateKes",
        "experienceYears",
        "certification",
        "bio",
        "availableNow",
        "remoteSupport",
        "languages",
        "photoUrl",
        "ratingAvg",
        "jobsCompleted",
        "createdAt",
        "updatedAt"
      ]
    },
    "Booking": {
      "title": "Booking",
      "description": "Customer job request and dispatch record with geolocation coordinates",
      "type": "object",
      "properties": {
        "customerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "customerPhone": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^(\\+254|0)[17]\\d{8}$"
        },
        "technicianId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "technicianOwnerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "technicianName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "trade": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "county": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "town": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "estateLandmark": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "issueDescription": {
          "type": "string",
          "minLength": 10,
          "maxLength": 600
        },
        "serviceMode": {
          "type": "string",
          "enum": ["onsite", "remote_triage"]
        },
        "urgency": {
          "type": "string",
          "enum": ["emergency", "scheduled"]
        },
        "scheduledDate": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40
        },
        "estimatedCalloutKes": {
          "type": "number"
        },
        "mpesaRef": {
          "type": "string",
          "maxLength": 30
        },
        "status": {
          "type": "string",
          "enum": ["requested", "accepted", "en_route", "in_progress", "completed", "cancelled"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "customerId",
        "customerName",
        "customerPhone",
        "technicianId",
        "technicianOwnerUid",
        "technicianName",
        "trade",
        "county",
        "town",
        "estateLandmark",
        "lat",
        "lng",
        "issueDescription",
        "serviceMode",
        "urgency",
        "scheduledDate",
        "estimatedCalloutKes",
        "mpesaRef",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Review": {
      "title": "Review",
      "description": "Verified customer review tied to a completed booking",
      "type": "object",
      "properties": {
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "technicianId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "bookingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "rating": {
          "type": "number"
        },
        "comment": {
          "type": "string",
          "minLength": 5,
          "maxLength": 400
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["authorUid", "authorName", "technicianId", "bookingId", "rating", "comment", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateProfile" },
      "description": "Isolated private user profile containing phone, email, and home county"
    },
    "/technicians/{technicianId}": {
      "schema": { "$ref": "#/entities/Technician" },
      "description": "Public directory of vetted Kenyan technicians across all 47 counties"
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Dispatch bookings accessible only to the customer, assigned technician, or admin"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Public customer reviews verified against completed bookings"
    }
  }
}
