rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.phone_number != null
      );
    }

    function isOwner(uid) {
      return isVerifiedUser() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email_verified == true && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'briannyagakyu@gmail.com'
      );
    }

    function isValidKenyanPhone(phone) {
      return phone is string && phone.size() <= 20 && phone.matches('^(\\+254|0)[17]\\d{8}$');
    }

    function isValidLatLng(lat, lng) {
      return lat is number && lat >= -90 && lat <= 90 && lng is number && lng >= -180 && lng <= 180;
    }

    function isBuiltInTechnicianId(techId) {
      return techId in [
        'tech-kamau-nairobi',
        'tech-wanjiku-kiambu',
        'tech-omondi-kisumu',
        'tech-mwangi-nakuru',
        'tech-hassan-mombasa',
        'tech-kiprop-eldoret',
        'tech-mutua-machakos',
        'tech-chebet-nyeri'
      ];
    }

    // --- Entity Validation Blueprints ---
    function isValidPrivateProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'email', 'mpesaPhone', 'county', 'town', 'role', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'email', 'mpesaPhone', 'county', 'town', 'role', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && isValidId(data.uid) && data.uid == userId
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 80
        && data.email is string && data.email.size() <= 120
        && data.mpesaPhone is string && data.mpesaPhone.size() <= 20 && data.mpesaPhone.matches('^(|(\\+254|0)[17]\\d{8})$')
        && data.county is string && data.county.size() >= 2 && data.county.size() <= 40
        && data.town is string && data.town.size() >= 2 && data.town.size() <= 80
        && data.role in ['customer', 'technician']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTechnician(data) {
      return data.keys().hasAll([
          'ownerUid', 'fullName', 'trade', 'county', 'town', 'lat', 'lng',
          'serviceRadiusKm', 'calloutFeeKes', 'hourlyRateKes', 'experienceYears',
          'certification', 'bio', 'availableNow', 'remoteSupport', 'languages',
          'photoUrl', 'ratingAvg', 'jobsCompleted', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'fullName', 'trade', 'county', 'town', 'lat', 'lng',
          'serviceRadiusKm', 'calloutFeeKes', 'hourlyRateKes', 'experienceYears',
          'certification', 'bio', 'availableNow', 'remoteSupport', 'languages',
          'photoUrl', 'ratingAvg', 'jobsCompleted', 'createdAt', 'updatedAt'
        ])
        && data.ownerUid is string && isValidId(data.ownerUid)
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 80
        && data.trade in [
          'Electrical & Solar',
          'Plumbing & Borehole',
          'Refrigeration & AC',
          'Automotive Diagnostics',
          'ICT & Fiber',
          'Appliance Repair',
          'Welding & Masonry'
        ]
        && data.county is string && data.county.size() >= 2 && data.county.size() <= 40
        && data.town is string && data.town.size() >= 2 && data.town.size() <= 80
        && isValidLatLng(data.lat, data.lng)
        && data.serviceRadiusKm is number && data.serviceRadiusKm >= 5 && data.serviceRadiusKm <= 300
        && data.calloutFeeKes is number && data.calloutFeeKes >= 300 && data.calloutFeeKes <= 50000
        && data.hourlyRateKes is number && data.hourlyRateKes >= 300 && data.hourlyRateKes <= 30000
        && data.experienceYears is number && data.experienceYears >= 0 && data.experienceYears <= 60
        && data.certification is string && data.certification.size() >= 2 && data.certification.size() <= 100
        && data.bio is string && data.bio.size() >= 10 && data.bio.size() <= 500
        && data.availableNow is bool
        && data.remoteSupport is bool
        && data.languages is list && data.languages.size() >= 1 && data.languages.size() <= 5
        && data.languages[0] is string && data.languages[0].size() >= 2 && data.languages[0].size() <= 30
        && data.photoUrl is string && data.photoUrl.size() <= 300
        && data.ratingAvg is number && data.ratingAvg >= 0 && data.ratingAvg <= 5
        && data.jobsCompleted is number && data.jobsCompleted >= 0 && data.jobsCompleted <= 100000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBooking(data) {
      return data.keys().hasAll([
          'customerId', 'customerName', 'customerPhone', 'technicianId',
          'technicianOwnerUid', 'technicianName', 'trade', 'county', 'town',
          'estateLandmark', 'lat', 'lng', 'issueDescription', 'serviceMode', 'urgency',
          'scheduledDate', 'estimatedCalloutKes', 'mpesaRef', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'customerId', 'customerName', 'customerPhone', 'technicianId',
          'technicianOwnerUid', 'technicianName', 'trade', 'county', 'town',
          'estateLandmark', 'lat', 'lng', 'issueDescription', 'serviceMode', 'urgency',
          'scheduledDate', 'estimatedCalloutKes', 'mpesaRef', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.customerId is string && isValidId(data.customerId)
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 80
        && isValidKenyanPhone(data.customerPhone)
        && data.technicianId is string && isValidId(data.technicianId)
        && data.technicianOwnerUid is string && isValidId(data.technicianOwnerUid)
        && data.technicianName is string && data.technicianName.size() >= 2 && data.technicianName.size() <= 80
        && data.trade is string && data.trade.size() >= 2 && data.trade.size() <= 60
        && data.county is string && data.county.size() >= 2 && data.county.size() <= 40
        && data.town is string && data.town.size() >= 2 && data.town.size() <= 80
        && data.estateLandmark is string && data.estateLandmark.size() >= 2 && data.estateLandmark.size() <= 160
        && isValidLatLng(data.lat, data.lng)
        && data.issueDescription is string && data.issueDescription.size() >= 10 && data.issueDescription.size() <= 600
        && data.serviceMode in ['onsite', 'remote_triage']
        && data.urgency in ['emergency', 'scheduled']
        && data.scheduledDate is string && data.scheduledDate.size() >= 4 && data.scheduledDate.size() <= 40
        && data.estimatedCalloutKes is number && data.estimatedCalloutKes >= 0 && data.estimatedCalloutKes <= 100000
        && data.mpesaRef is string && data.mpesaRef.size() <= 30
        && data.status in ['requested', 'accepted', 'en_route', 'in_progress', 'completed', 'cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReview(data) {
      return data.keys().hasAll([
          'authorUid', 'authorName', 'technicianId', 'bookingId', 'rating', 'comment', 'createdAt'
        ])
        && data.keys().hasOnly([
          'authorUid', 'authorName', 'technicianId', 'bookingId', 'rating', 'comment', 'createdAt'
        ])
        && data.authorUid is string && isValidId(data.authorUid)
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 80
        && data.technicianId is string && isValidId(data.technicianId)
        && data.bookingId is string && isValidId(data.bookingId)
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() >= 5 && data.comment.size() <= 400
        && data.createdAt is timestamp;
    }

    // --- Collection Rules ---

    match /test/connection {
      allow get: if true;
    }

    // Isolated Private User Profiles (PII)
    match /users/{userId}/private/{docId} {
      allow get: if isValidId(userId) && docId == 'profile' && isOwner(userId);
      allow create: if isValidId(userId)
        && docId == 'profile'
        && isOwner(userId)
        && isValidPrivateProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && docId == 'profile'
        && isOwner(userId)
        && isValidPrivateProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'mpesaPhone', 'county', 'town', 'role', 'updatedAt'
        ]);
    }

    // Public Kenyan Technician Directory (No PII)
    match /technicians/{technicianId} {
      allow get: if isValidId(technicianId);
      allow list: if true;
      allow create: if isVerifiedUser()
        && isValidId(technicianId)
        && isValidTechnician(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (
            incoming().ownerUid == request.auth.uid &&
            incoming().ratingAvg == 0 &&
            incoming().jobsCompleted == 0
          ) ||
          (isAdmin() && incoming().ownerUid == 'platform_verified')
        );
      allow update: if isVerifiedUser()
        && isValidId(technicianId)
        && isValidTechnician(incoming())
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().ownerUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName', 'trade', 'county', 'town', 'lat', 'lng', 'serviceRadiusKm',
              'calloutFeeKes', 'hourlyRateKes', 'experienceYears', 'certification',
              'bio', 'availableNow', 'remoteSupport', 'languages', 'photoUrl', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerifiedUser()
        && isValidId(technicianId)
        && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    // Bookings & Dispatch Lifecycle
    match /bookings/{bookingId} {
      allow get: if isVerifiedUser()
        && isValidId(bookingId)
        && (
          existing().customerId == request.auth.uid ||
          existing().technicianOwnerUid == request.auth.uid ||
          isAdmin()
        );
      allow list: if isVerifiedUser()
        && (
          resource.data.customerId == request.auth.uid ||
          resource.data.technicianOwnerUid == request.auth.uid ||
          isAdmin()
        );
      allow create: if isVerifiedUser()
        && isValidId(bookingId)
        && isValidBooking(incoming())
        && incoming().customerId == request.auth.uid
        && incoming().status == 'requested'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (
            exists(/databases/$(database)/documents/technicians/$(incoming().technicianId)) &&
            get(/databases/$(database)/documents/technicians/$(incoming().technicianId)).data.ownerUid == incoming().technicianOwnerUid
          ) ||
          (
            isBuiltInTechnicianId(incoming().technicianId) &&
            incoming().technicianOwnerUid == 'platform_verified'
          )
        );
      allow update: if isVerifiedUser()
        && isValidId(bookingId)
        && isValidBooking(incoming())
        && incoming().customerId == existing().customerId
        && incoming().technicianId == existing().technicianId
        && incoming().technicianOwnerUid == existing().technicianOwnerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().status != 'completed' &&
            existing().status != 'cancelled' &&
            (
              // Tier 1: Customer cancels before work starts or records M-Pesa confirmation ref
              (
                existing().customerId == request.auth.uid &&
                (
                  (
                    incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                    incoming().status == 'cancelled' &&
                    existing().status in ['requested', 'accepted']
                  ) ||
                  incoming().diff(existing()).affectedKeys().hasOnly(['mpesaRef', 'updatedAt'])
                )
              ) ||
              // Tier 2: Assigned Technician advances dispatch state
              (
                existing().technicianOwnerUid == request.auth.uid &&
                incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                (
                  (existing().status == 'requested' && incoming().status in ['accepted', 'cancelled']) ||
                  (existing().status == 'accepted' && incoming().status in ['en_route', 'cancelled']) ||
                  (existing().status == 'en_route' && incoming().status == 'in_progress') ||
                  (existing().status == 'in_progress' && incoming().status == 'completed')
                )
              )
            )
          )
        );
      allow delete: if isAdmin() && isValidId(bookingId);
    }

    // Verified Customer Reviews (1 review per completed booking)
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if true;
      allow create: if isVerifiedUser()
        && isValidId(reviewId)
        && isValidReview(incoming())
        && reviewId == incoming().bookingId
        && incoming().authorUid == request.auth.uid
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/bookings/$(incoming().bookingId))
        && get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.customerId == request.auth.uid
        && get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.technicianId == incoming().technicianId
        && get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.status == 'completed';
      allow update: if isVerifiedUser()
        && isValidId(reviewId)
        && isValidReview(incoming())
        && existing().authorUid == request.auth.uid
        && incoming().authorUid == existing().authorUid
        && incoming().authorName == existing().authorName
        && incoming().technicianId == existing().technicianId
        && incoming().bookingId == existing().bookingId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'comment']);
      allow delete: if isVerifiedUser()
        && isValidId(reviewId)
        && (existing().authorUid == request.auth.uid || isAdmin());
    }
  }
}
